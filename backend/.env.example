# Database
DATABASE_URL=sqlite:///./crm.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_URL=http://localhost:8080

# Email (SMTP) - Optional, for password reset functionality
# Leave empty to use development mode (prints to console)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pretorin.com
SMTP_FROM_NAME=Pretorin CRM

# Google OAuth - Optional, for SSO authentication
# Get these values from Google Cloud Console > APIs & Services > Credentials
# Leave empty to disable OIDC and use only email/password authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback
